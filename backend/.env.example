# Backend infrastructure settings. Copy to backend/.env for backend-only config.
DATABASE_URL=sqlite+aiosqlite:///ai_configs.db
# CORS_ORIGINS=http://localhost:3000,http://localhost:9000
CORS_ORIGINS=https://langchain-graph.thedevlogix.com
HOST=0.0.0.0
PORT=9000

MASTER_CHATBOT_REGISTRATION_KEY=replace-with-a-long-random-registration-key
MASTER_CHATBOT_CONFIG_KEY=replace-with-a-long-random-config-key
SECRET_KEY=replace-with-a-long-random-secret-key

ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800
MASTER_CHATBOT_MAX_RESULT_ITEMS=25
