# Production: nginx forwards /chatbot/ to Master Chatbot on port 9000.
# The bare shared domain routes /api/ to ShopNest instead.
NEXT_PUBLIC_API_BASE_URL=/chatbot

# For local next dev, set http://localhost:9000 in .env.local.
# A separately hosted backend can use its own full HTTPS URL instead.
NEXT_PUBLIC_USE_AUTH_FALLBACK=false
