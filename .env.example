HIS_API_URL=http://localhost:8000
HIS_JWT_SECRET=replace-with-the-HIS-backend-secret
HIS_JWT_ALGORITHM=HS256
HIS_MASTER_CHATBOT_SERVICE_KEY=replace-with-a-long-random-service-key
ECOMMERCE_API_URL=http://localhost:8000
ECOMMERCE_JWT_SECRET=replace-with-the-ecommerce-backend-secret
ECOMMERCE_MASTER_CHATBOT_SERVICE_KEY=replace-with-a-long-random-service-key
HRM_API_URL=http://localhost:3333
HRM_JWT_SECRET=replace-with-the-hrm-backend-secret
HRM_MASTER_CHATBOT_SERVICE_KEY=replace-with-a-long-random-service-key

# Database (defaults to SQLite ai_configs.db if omitted)
DATABASE_URL=sqlite+aiosqlite:///ai_configs.db
